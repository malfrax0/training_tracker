{
  "name": "training-tracker",
  "private": true,
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c cyan,magenta \"pnpm --filter backend dev\" \"pnpm --filter frontend dev\"",
    "build": "pnpm --filter backend build && pnpm --filter frontend build",
    "lint": "pnpm -r lint",
    "db:migrate": "pnpm --filter backend db:migrate",
    "docker:up": "docker-compose up --build",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:down:volumes": "docker-compose down -v",
    "e2e:open": "pnpm --filter e2e open",
    "e2e:run": "pnpm --filter e2e run"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
